# ---------------------------------------------------------------------------
# Shamba Score — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
# Supabase dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe to expose to the browser; every request
# it makes is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. OPTIONAL — nothing in the app uses it.
#
# Onboarding goes through two SECURITY DEFINER database functions instead, so
# the app never needs a key that bypasses Row Level Security. Leave this blank
# unless you add an admin script that genuinely needs it, and if you do: SERVER
# ONLY, never prefixed with NEXT_PUBLIC_, never imported into a client
# component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Data adapters. "mock" runs the whole app with no external API keys.
# Valid values: mock | live
# ---------------------------------------------------------------------------
SATELLITE_ADAPTER=mock
WEATHER_ADAPTER=mock
MOBILE_MONEY_ADAPTER=mock

# Seed for the deterministic mock adapters. Same seed + same farm = same
# features, so demos and tests are reproducible.
MOCK_ADAPTER_SEED=shamba-dev
